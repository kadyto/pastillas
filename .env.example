# Carpeta local ya creada en el host Docker, propiedad del UID/GID elegido.
DATA_DIR=/ruta/absoluta/docker/pastillas/data
APP_UID=10001
APP_GID=10001
APP_PORT=8092
BIND_ADDRESS=0.0.0.0
INITIAL_ADMIN_USER=miusuario
# Sustituye esto por una contraseña propia de al menos 12 caracteres.
INITIAL_ADMIN_PASSWORD=
# auto detecta HTTPS mediante X-Forwarded-Proto (Nginx Proxy Manager).
COOKIE_SECURE=auto
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOKEN=

# Opcional: actualización desde la app mediante el webhook del stack Git de Dockhand.
# URL sin secreto en la consulta; la app firma la petición con el secreto separado.
DOCKHAND_WEBHOOK_URL=
DOCKHAND_WEBHOOK_SECRET=
